# OmegA-FCA runtime secrets. Never commit a real .env file.
AGENT_BACKEND_URL=https://your-agent-backend.example
OMEGA_FCA_LICENSE_ID=lic_<32-hex-characters>
OMEGA_FCA_INSTALLATION_ID=<owner-approved-installation-id>
OMEGA_FCA_LICENSE_KEY=<one-time-owner-issued-license-key>
OMEGA_FCA_LICENSE_PUBLIC_KEY=<Ed25519-public-PEM-with-newlines-escaped-as-\n>

# 32 random bytes encoded as 64 hexadecimal characters.
OMEGA_FCA_SESSION_KEY=<64-character-random-hex>

# Optional official Meta Messenger Page transport configuration.
# Use a supported Graph API version for your Meta app.
META_PAGE_ACCESS_TOKEN=<page-access-token>
META_PAGE_ID=<numeric-page-id>
META_GRAPH_API_VERSION=<supported-version-such-as-v25.0>
META_APP_SECRET=<meta-app-secret>
META_WEBHOOK_VERIFY_TOKEN=<random-webhook-verification-token>
