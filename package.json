{
  "name": "@omega/fca",
  "version": "0.1.1",
  "description": "OmegA Bot Facebook integration library, developed and maintained by NirZon",
  "main": "index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "test:syntax": "node -e \"const fs=require('node:fs');const path=require('node:path');const cp=require('node:child_process');const walk=d=>fs.readdirSync(d,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(path.join(d,e.name)):[path.join(d,e.name)]);for(const f of ['index.js',...walk('src'),...walk('test'),...walk('examples')].filter(f=>f.endsWith('.js'))){const r=cp.spawnSync(process.execPath,['--check',f],{stdio:'inherit'});if(r.status!==0)process.exit(r.status||1)}\"",
    "prepublishOnly": "npm test && npm run test:syntax",
    "test:appstate": "node examples/appstate-session-check.js",
    "capture:browser": "node tools/browser-capture.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/octopusworldpro-web/OmegA-FCA-2.git"
  },
  "homepage": "https://github.com/octopusworldpro-web/OmegA-FCA-2#readme",
  "keywords": [
    "facebook",
    "messenger",
    "fca",
    "nodejs",
    "omega"
  ],
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "src/",
    "examples/",
    "README.md",
    "LICENSE",
    "docs/META-MESSENGER-TRANSPORT.md",
    "docs/DEPLOYMENT.md",
    "docs/PROTOCOL-EVIDENCE.md",
    "docs/AUTHENTICATION-ATTEMPT.md",
    "docs/IMPLEMENTATION-STATUS.md",
    "docs/ARCHITECTURE.md",
    "docs/GOATBOT-COMPATIBILITY-MATRIX.md",
    "docs/GOATBOT-INTEGRATION-AUDIT.md",
    "docs/REFERENCE-AUDIT.md",
    "docs/NTKHANG-REFERENCE-STUDY.md",
    "docs/SAFE-DIAGNOSTICS.md",
    "docs/REALTIME-FRAME-EVIDENCE.md",
    "docs/NESTED-REALTIME-PAYLOAD.md"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "default": "./index.js"
    }
  },
  "author": "NirZon",
  "devDependencies": {
    "playwright": "^1.56.1"
  }
}
